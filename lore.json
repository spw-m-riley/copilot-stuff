{
  "$schema": "./extensions/lore/schemas/lore.schema.json",
  "enabled": true,
  "localInference": {
    "enabled": true,
    "baseUrl": "http://127.0.0.1:12434/v1",
    "model": "docker.io/ai/gemma4:latest",
    "timeoutMs": 120000,
    "maxInputChars": 24000,
    "maxOutputTokens": 2400,
    "temperature": 0,
    "reflection": {
      "enabledByDefault": true
    },
    "queryExpansion": {
      "enabled": true,
      "maxTerms": 6
    },
    "contextCompression": {
      "enabled": true,
      "minInputTokens": 900,
      "targetTokens": 700,
      "maxSections": 8
    },
    "analysis": {
      "consolidation": {
        "enabled": true,
        "maxItems": 4
      },
      "contradictions": {
        "enabled": true,
        "maxItems": 4
      },
      "trends": {
        "enabled": true,
        "maxItems": 4,
        "minOccurrences": 2
      },
      "qualityEvaluation": {
        "enabled": true,
        "minSupport": 0.8,
        "minSpecificity": 0.6,
        "minUsefulness": 0.6
      }
    },
    "embeddings": {
      "enabled": true,
      "model": "docker.io/ai/embeddinggemma:latest",
      "maxInputs": 41,
      "topK": 6,
      "minSimilarity": 0.2,
      "groundingMinSimilarity": 0.35
    }
  },
  "latencyTargetsMs": {
    "sessionStartP95": 100,
    "userPromptSubmittedP95": 150
  },
  "latencyReadinessMinSamples": {
    "sessionStart": 20,
    "userPromptSubmitted": 50
  },
  "deferredExtraction": {
    "enabled": true,
    "autoEnqueueOnSessionEnd": true,
    "autoProcessOnSessionStart": true,
    "processCurrentRepositoryOnly": true,
    "useLocalInference": true
  },
  "maintenanceScheduler": {
    "enabled": true,
    "autoRunOnSessionStart": true,
    "maxTasksPerRun": 4,
    "sessionStartBackfill": {
      "enabled": true,
      "includeOtherRepositories": true,
      "refreshExisting": false,
      "batchSize": 25,
      "maxCandidates": 250,
      "maxInspected": 2000,
      "notifyEveryItems": 25
    },
    "tasks": {
      "deferredExtraction": true,
      "validationCorpus": true,
      "replayCorpus": true,
      "backlogReview": true,
      "traceCompaction": true,
      "indexUpkeep": true,
      "doctorSnapshot": true
    }
  },
  "traceRecorder": {
    "maxRecords": 40,
    "maxAgeMs": 1800000,
    "maxRowsPerLookup": 3,
    "maxFilteredRowsPerLookup": 3,
    "maxPromptChars": 160,
    "maxRowChars": 160,
    "maxContextChars": 600,
    "persistDurableSample": true
  },
  "rollout": {
    "ambientPersonaMode": true,
    "autoWriteImprovementGoals": true,
    "directives": true,
    "evolutionLedger": true,
    "generatedArtifactIntegrity": true,
    "hybridRetrieval": true,
    "loreDoctor": true,
    "memoryDomains": true,
    "memoryOperations": true,
    "overlayAutoHydration": true,
    "proposalGeneration": true,
    "refreshableObservations": true,
    "retentionSanitization": true,
    "reviewGate": true,
    "temporalQueryNormalization": true,
    "traceRecorder": true,
    "workstreamOverlays": true
  }
}
