# Shareable Copilot settings should stay trackable:
# - ide/

# Local Copilot config
/config.json
/config/skill-defaults.local.yaml

# Local CLI history and per-session artifacts
/command-history-state.json
/*.db
/*.db.pre-update-backup-*
/*.db-shm
/*.db-wal
/session-state/

# Local runtime output
/logs/

# Downloaded/runtime package assets
/pkg/
/backups/

# macOS/editor noise
.DS_Store
*.swp
*~

.worktrees/
# Runtime-installed plugins - not tracked
installed-plugins/
.fallow/
permissions-config.json

# Runtime scratch and Copilot CLI state directories
.tmp/
run/
restart/
ide/
plugin-data/
updater/
