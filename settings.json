{
  "alt_screen": true,
  "compactPaste": true,
  "continueOnAutoMode": true,
  "copyOnSelect": true,
  "enabledPlugins": {
    "copilot-sdk@awesome-copilot": true,
    "ponytail@ponytail": true
  },
  "experimental": true,
  "extensions": {
    "mode": "load_and_augment"
  },
  "extraKnownMarketplaces": {
    "lucky-hat": {
      "source": {
        "source": "github",
        "repo": "matt-riley/lucky-hat"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAgent": true
  },
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash '/Users/matthew.riley/.copilot/hooks/herdr-agent-state.sh'",
        "timeoutSec": 10
      }
    ]
  },
  "ide.auto_connect": true,
  "ide.open_diff_on_edit": true,
  "includeCoAuthoredBy": false,
  "mouse": true,
  "renderMarkdown": true,
  "rollout": {},
  "stream": true,
  "subagents": {
    "agents": {
      "explore": {
        "model": "auto"
      },
      "general-purpose": {
        "model": "auto"
      }
    }
  },
  "updateTerminalTitle": true,
  "voice": {
    "enabled": true,
    "selectedModel": "nemotron-speech-streaming-en-0.6b-generic-cpu:3"
  }
}
